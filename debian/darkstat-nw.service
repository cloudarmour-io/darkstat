[Unit]
Description=darkstat-nw network traffic monitor
Documentation=man:darkstat(8)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/default/darkstat-nw
ExecStart=/usr/lib/darkstat-nw/darkstat-nw-wrapper
Restart=always
RestartSec=5s

# darkstat opens capture sockets as root then drops privileges itself.
User=root
Group=root

[Install]
WantedBy=multi-user.target
